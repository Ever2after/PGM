{
  "models": ["gemma4b", "qwen7b", "llama8b"],
  "datasets": ["math", "gsm8k", "omnimath"],
  "variants": ["M1", "constant_theta", "P1_independent", "P1_linked", "quadratic_theta"],
  "training": {
    "objective": "joint_nll_per_response",
    "unique_correct_only": true,
    "restart_seeds": [0, 43, 44],
    "initialization_sd": 0.5,
    "sigma_starts": [0.25, 0.75, 1.5],
    "max_iter": 300,
    "ridge": 0.00000625,
    "tolerance_grad": 1e-7,
    "tolerance_change": 1e-10
  },
  "integration": {
    "normal_nodes": [61, 121, 181, 241],
    "tolerance": 0.001,
    "sigma_bound": 3.0,
    "q_grid": "released M1: 80 nodes, logits [-7,7]"
  },
  "evaluation": {
    "splits": ["dev", "test"],
    "prefixes": [1, 2, 4, 8, 16],
    "horizons": [1, 2, 4, 8],
    "simulations_per_seed": 256,
    "mc_seeds": [20261125, 20261126, 20261127],
    "bootstrap_replicates": 1000,
    "bootstrap_seed": 20261125,
    "paired_gain": true,
    "reference": "valid-answer plurality, earliest observed answer wins ties"
  }
}
